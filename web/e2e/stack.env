# Ports of the end-to-end test stack, a separate Compose project (cultivation-diary-e2e) with its own database,
# so the tests can wipe and reseed it without touching the development stack. Layered over .env.
WEB_PORT=8081
MANTRA_PORT=8083
MANTRA_URL=http://localhost:8083
PORT=3001
DB_PORT=55433
# The tests exercise the authenticator, whatever the development .env says.
SKIP_TOTP=false
